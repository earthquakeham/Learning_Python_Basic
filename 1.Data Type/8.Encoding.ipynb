   "source": [
    "# encoding, 문자를 컴퓨터가 인지 할 수 있는 low level 로 변환\n",
    "a = \"한글\"\n",
    "b = a.encode('utf-8')  # utf(unicode transation format)\n",
    "c = a.encode('euc-kr') # ecu-kr 한글을 2byte로 변환하는 오래된 방식\n",
    "print(b)\n",
    "print(c)\n",
    "print(b.decode('utf-8'))\n",
    "print(c.decode('euc-kr'))"
   ]
  }
 ],
